{
    "name": "PL_AzureSQL_IncrementalLoad",
    "objectId": "58129a30-b457-420b-b92f-da9f686f14a4",
    "properties": {
        "activities": [
            {
                "name": "Lookup_Metadata",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": "SELECT\n    m.EntityName,\n    m.SourceType,\n    m.SourceObject,\n    m.TargetTable,\n    m.WatermarkColumn,\n    m.BusinessKey,\n    m.LoadType,\n    m.TargetType,\n    w.LastWatermark\nFROM dbo.MetadataControl m\nLEFT JOIN dbo.WatermarkControl w\n    ON m.SourceObject = w.SourceTable\nWHERE m.SourceType = 'AzureSQL'\n  AND m.IsActive = 1;",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "firstRowOnly": false,
                    "datasetSettings": {
                        "annotations": [],
                        "type": "AzureSqlTable",
                        "schema": [],
                        "typeProperties": {
                            "database": "SQLServerDatabase"
                        },
                        "externalReferences": {
                            "connection": "0cc6bd6b-8d75-4343-8748-4803c7dc99dd"
                        }
                    }
                }
            },
            {
                "name": "ForEach_SQLTables",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Lookup_Metadata",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Lookup_Metadata').output.value",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "Copy_SQL_To_Lakehouse_Incremental",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "@concat(\n    'SELECT * FROM dbo.',\n    item().SourceObject,\n    ' WHERE ',\n    item().WatermarkColumn,\n    ' > ''',\n    item().LastWatermark,\n    ''''\n)",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None",
                                    "datasetSettings": {
                                        "annotations": [],
                                        "type": "AzureSqlTable",
                                        "schema": [],
                                        "typeProperties": {
                                            "database": "SQLServerDatabase"
                                        },
                                        "externalReferences": {
                                            "connection": "0cc6bd6b-8d75-4343-8748-4803c7dc99dd"
                                        }
                                    }
                                },
                                "sink": {
                                    "type": "LakehouseTableSink",
                                    "tableActionOption": "Upsert",
                                    "upsertSettings": {
                                        "keys": {
                                            "value": "@createArray(item().BusinessKey)",
                                            "type": "Expression"
                                        }
                                    },
                                    "applyVOrder": false,
                                    "enableTimestampNtz": false,
                                    "datasetSettings": {
                                        "annotations": [],
                                        "linkedService": {
                                            "name": "LH_IncrementalLoad",
                                            "properties": {
                                                "annotations": [],
                                                "type": "Lakehouse",
                                                "typeProperties": {
                                                    "workspaceId": "bb9e0ae2-f03d-477b-b31d-1c85784f1530",
                                                    "artifactId": "5b634eb1-2473-460d-a75c-313cfc6c7c24",
                                                    "rootFolder": "Tables"
                                                }
                                            }
                                        },
                                        "type": "LakehouseTable",
                                        "schema": [],
                                        "typeProperties": {
                                            "schema": "dbo",
                                            "table": {
                                                "value": "@item().TargetTable\n\n",
                                                "type": "Expression"
                                            }
                                        }
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            }
                        },
                        {
                            "name": "Lookup_MaxWatermark",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "Copy_SQL_To_Lakehouse_Incremental",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "@concat(\n    'SELECT MAX(',\n    item().WatermarkColumn,\n    ') AS MaxWatermark FROM dbo.',\n    item().SourceObject\n)",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "datasetSettings": {
                                    "annotations": [],
                                    "type": "AzureSqlTable",
                                    "schema": [],
                                    "typeProperties": {
                                        "database": "SQLServerDatabase"
                                    },
                                    "externalReferences": {
                                        "connection": "0cc6bd6b-8d75-4343-8748-4803c7dc99dd"
                                    }
                                }
                            }
                        },
                        {
                            "name": "Update_Watermark",
                            "description": "",
                            "type": "Script",
                            "dependsOn": [
                                {
                                    "activity": "Lookup_MaxWatermark",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": {
                                            "value": "@concat(\n    'UPDATE dbo.WatermarkControl ',\n    'SET LastWatermark = ''',\n    activity('Lookup_MaxWatermark').output.firstRow.MaxWatermark,\n    ''' ',\n    'WHERE SourceTable = ''',\n    item().SourceObject,\n    ''''\n)",
                                            "type": "Expression"
                                        }
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00",
                                "database": "SQLServerDatabase"
                            },
                            "externalReferences": {
                                "connection": "0cc6bd6b-8d75-4343-8748-4803c7dc99dd"
                            }
                        },
                        {
                            "name": "Audit_SQL_Load",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Update_Watermark",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "storedProcedureName": "[dbo].[usp_InsertETLAudit]",
                                "database": "SQLServerDatabase",
                                "storedProcedureParameters": {
                                    "ErrorMessage": {
                                        "value": null,
                                        "type": "String"
                                    },
                                    "PipelineName": {
                                        "value": {
                                            "value": "PL_AzureSQL_IncrementalLoad",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "RowsInserted": {
                                        "value": {
                                            "value": "@activity('Copy_SQL_To_Lakehouse_Incremental').output.rowsCopied",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "RowsRead": {
                                        "value": {
                                            "value": "@activity('Copy_SQL_To_Lakehouse_Incremental').output.rowsRead",
                                            "type": "Expression"
                                        },
                                        "type": "Int32"
                                    },
                                    "RowsRejected": {
                                        "value": "0",
                                        "type": "Int32"
                                    },
                                    "RowsUpdated": {
                                        "value": "0",
                                        "type": "Int32"
                                    },
                                    "RunEndTime": {
                                        "value": {
                                            "value": "@utcNow()",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "RunStartTime": {
                                        "value": {
                                            "value": "@pipeline().TriggerTime",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "Status": {
                                        "value": "SUCCESS",
                                        "type": "String"
                                    },
                                    "TableName": {
                                        "value": {
                                            "value": "@item().EntityName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "externalReferences": {
                                "connection": "0cc6bd6b-8d75-4343-8748-4803c7dc99dd"
                            }
                        },
                        {
                            "name": "Log_Error",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "Update_Watermark",
                                    "dependencyConditions": [
                                        "Failed"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "storedProcedureName": "[dbo].[usp_InsertETLError]",
                                "database": "SQLServerDatabase",
                                "storedProcedureParameters": {
                                    "ErrorMessage": {
                                        "value": {
                                            "value": "@activity('Update_Watermark').error.message",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "ErrorTime": {
                                        "value": {
                                            "value": "@utcNow()",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    },
                                    "PipelineName": {
                                        "value": {
                                            "value": "@pipeline().Pipeline",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "TableName": {
                                        "value": {
                                            "value": "@item().SourceTable",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "externalReferences": {
                                "connection": "0cc6bd6b-8d75-4343-8748-4803c7dc99dd"
                            }
                        }
                    ]
                }
            }
        ],
        "lastModifiedByObjectId": "c6b56cfa-ebf5-4056-b716-99610941ab63",
        "lastPublishTime": "2026-09-05T15:37:46Z"
    }
}